{
  "manifest_version": 3,
  "name": "PolyBatch",
  "version": "0.1.0",
  "description": "One-click batch buy across multiple Polymarket bins: pick bins, set direction and share size, see combined cost live.",
  "content_scripts": [
    {
      "matches": ["https://polymarket.com/*"],
      "js": ["cost.js", "clob.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://gamma-api.polymarket.com/*",
    "https://clob.polymarket.com/*"
  ]
}
